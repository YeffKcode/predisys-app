{
  "name": "predisys-api",
  "version": "1.0.0",
  "description": "PrediSys - API de monitoreo telem\u00e9trico y predicci\u00f3n de fallas en GPUs de miner\u00eda",
  "main": "src/server.js",
  "private": true,
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "setup": "node scripts/init-env.js && npm install && prisma generate && prisma db push && prisma db seed",
    "chain:deploy": "node blockchain/deploy.js",
    "simulate": "node scripts/simulate-telemetry.js",
    "client:dev": "npm --prefix client run dev",
    "client:build": "npm --prefix client install && npm --prefix client run build",
    "init-env": "node scripts/init-env.js",
    "db:update": "prisma db push && prisma db seed",
    "admin:diagnose": "node scripts/admin-reset.js --diagnose",
    "admin:reset": "node scripts/admin-reset.js",
    "notify:check": "node scripts/notify-check.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@aws-sdk/client-sns": "3.687.0",
    "@prisma/client": "5.22.0",
    "bcryptjs": "2.4.3",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "ethers": "6.13.4",
    "express": "4.21.2",
    "express-rate-limit": "7.4.1",
    "helmet": "7.1.0",
    "jsonwebtoken": "9.0.2",
    "multer": "1.4.5-lts.1",
    "nodemailer": "6.9.16",
    "pdfkit": "0.15.0",
    "winston": "3.17.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "prisma": "5.22.0",
    "solc": "0.8.24"
  }
}
