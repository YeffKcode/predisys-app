# ───────────── Servidor ─────────────
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
TRUST_PROXY=false

# ───────────── Base de datos (MySQL local o Amazon RDS) ─────────────
# RDS: mysql://usuario:clave@predisys.xxxxx.us-east-1.rds.amazonaws.com:3306/predisys?sslaccept=strict
DATABASE_URL=mysql://predisys:predisys_pass@localhost:3306/predisys

# ───────────── Seguridad ─────────────
# Genera cada secreto con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CAMBIAR_por_64_caracteres_hex_aleatorios
DATA_ENCRYPTION_KEY=CAMBIAR_por_64_caracteres_hex_exactos
EMAIL_HASH_KEY=CAMBIAR_por_64_caracteres_hex_aleatorios
BCRYPT_ROUNDS=12
COOKIE_SECURE=false
LOCKOUT_MINUTES=15

# Valores iniciales (luego se ajustan en caliente desde /admin)
DEFAULT_TOKEN_TTL_MINUTES=15
DEFAULT_SESSION_IDLE_MINUTES=30
DEFAULT_MAX_CONCURRENT_SESSIONS=5
ABSOLUTE_SESSION_HOURS=12

# ───────────── Correo ─────────────
# Vacío = modo consola: los correos NO se envían, solo se imprimen en la terminal de la API.
# Opción A · Gmail (lo más rápido para el proyecto): activa la verificación en 2 pasos en tu cuenta
#   y crea una «contraseña de aplicación» en https://myaccount.google.com/apppasswords
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_SECURE=false
#   SMTP_USER=tucuenta@gmail.com  SMTP_PASS="xxxx xxxx xxxx xxxx"  MAIL_FROM="PrediSys <tucuenta@gmail.com>"
# Opción B · Amazon SES: verifica tu dominio o correo y crea credenciales SMTP en la consola de SES
#   SMTP_HOST=email-smtp.us-east-1.amazonaws.com  SMTP_PORT=587  (en sandbox solo envía a correos verificados)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="PrediSys <no-reply@predisys.local>"

# ───────────── Microservicio ML (Isolation Forest + Random Forest) ─────────────
ML_SERVICE_URL=http://localhost:8000
# Secreto compartido con ml-service (cabecera X-Internal-Token). ml-service lee ESTE mismo archivo.
# npm run init-env lo genera automáticamente.
ML_SERVICE_TOKEN=CAMBIAR_por_token_compartido
ML_TIMEOUT_MS=5000
ML_WINDOW_SIZE=12
ALERT_THRESHOLD=0.70
WARNING_THRESHOLD=0.40

# ───────────── Alertas y notificaciones ─────────────
APP_URL=http://localhost:5173
# No se crea una alerta nueva por la misma máquina dentro de esta ventana (evita spam de SMS)
ALERT_COOLDOWN_MINUTES=30
# Alerta CRÍTICA sin reconocer tras N minutos → se escala a usuarios con alerts.manage
ALERT_ESCALATION_MINUTES=15
ALERT_WORKER_INTERVAL_SECONDS=60
NOTIFY_TIMEZONE=America/Bogota
# Lista de guardia (separada por comas): reciben toda alerta CRÍTICA
ALERT_ONCALL_EMAILS=
ALERT_ONCALL_PHONES=
# SMS: console (NO envía nada, solo imprime) | twilio | sns
# Twilio: cuenta de prueba gratuita; solo envía a números que verifiques en su consola.
# Amazon SNS: usa las credenciales IAM del entorno; en sandbox solo envía a números verificados.
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
AWS_REGION=us-east-1
SNS_SENDER_ID=

# ───────────── Blockchain (solo Testnet) ─────────────
BLOCKCHAIN_ENABLED=false
CHAIN_NAME=sepolia
CHAIN_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CHAIN_ID=11155111
# Wallet EXCLUSIVA de pruebas, con ETH de faucet. Nunca una wallet con fondos reales.
CHAIN_PRIVATE_KEY=
ALERT_REGISTRY_ADDRESS=
CHAIN_EXPLORER_TX_URL=https://sepolia.etherscan.io/tx/
CHAIN_CONFIRMATIONS=1

# ───────────── Archivos ─────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# ───────────── Seed ─────────────
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@predisys.local
# Siempre entre comillas dobles: un # sin comillas inicia un comentario y recorta el valor.
SEED_ADMIN_PASSWORD="Pr3d!Sys!Adm2026"

# ───────────── Simulador de telemetría (npm run simulate) ─────────────
SIM_API_URL=http://localhost:4000/api
SIM_USERNAME=admin
SIM_PASSWORD="Pr3d!Sys!Adm2026"
